# Salin ke .env untuk pengembangan lokal. Jangan commit .env.
LINGKUNGAN=dev
DIR_DATA=data-salinan
ORIGIN_APP=http://localhost:3000
CACHE_MAX_AGE=3600
# Supabase (fase 4): URL proyek + kunci service role dari dashboard
# (Settings -> API). Kunci ini rahasia sisi server - jangan pernah commit.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Rate limit per-IP bawaan seluruh endpoint (format slowapi/limits).
LAJU_BAWAAN=120/minute
# Audience yang wajib ada di klaim `aud` token Supabase.
JWT_AUDIENCE=authenticated
# Jumlah worker proses. WAJIB 1 di luar LINGKUNGAN=dev: gerbang "satu
# pekerjaan penyegaran pada satu waktu" menyimpan state di memori proses,
# jadi lebih dari satu worker mengubahnya menjadi satu pekerjaan PER worker
# (ADR-0010). Boot gagal kalau nilainya lebih dari 1 di luar dev.
WEB_CONCURRENCY=1
# Gemini BERITA DESA (fase 6): penyaring + perangkum panen RSS.
# Kosong = fallback rangkuman ekstraktif tanpa saring topik LLM.
GEMINI_API_KEY=
# Gemini ASISTEN DESA (fase 5): kunci TERPISAH supaya kuota chat dan kuota
# panen berita tidak saling menghabiskan. Kosong = POST /api/chat membalas
# 503 AI_BELUM_SIAP; tidak pernah jatuh ke GEMINI_API_KEY.
GEMINI_API_KEY_CHAT=
# Model Asisten Desa. Alias "-latest" disengaja: nama pinned
# gemini-2.5-flash-lite terbukti 404 di endpoint generateContent walau
# tampil di ListModels.
MODEL_CHAT=gemini-flash-latest
MODEL_CHAT_CADANGAN=gemini-flash-lite-latest
# Batas masukan satu permintaan chat.
CHAT_MAKS_PESAN=20
CHAT_MAKS_KARAKTER=4000
# Maksimum putaran pemanggilan fungsi sebelum jawaban dipaksa keluar.
CHAT_MAKS_PUTARAN_ALAT=5
# Rate limit /api/chat PER PENGGUNA (bukan per IP, tidak seperti LAJU_BAWAAN).
LAJU_CHAT=10/minute;200/day
# Ambang maxsize empat cache LRU pembaca berkas. Ini tombol MEMORI, bukan
# kecepatan: satu entri jalur ekonomi terukur +-103 MB RAM (berkasnya 15,6 MB
# di disk), satu entri kartu kabupaten +-13 MB, dan muat Simpanan saat start
# sudah +-164 MB. Nilai di bawah aman untuk mesin pengembangan; host 512 MB
# WAJIB menurunkannya - lihat DEPLOY.md. Nol dan negatif
# ditolak saat boot (lru_cache membaca keduanya sebagai "tanpa cache").
MAKS_CACHE_KARTU=16
MAKS_CACHE_JALUR=4
MAKS_CACHE_CITRA=16
MAKS_CACHE_KEMBAR=16
